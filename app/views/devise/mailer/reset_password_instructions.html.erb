<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;background: linear-gradient(167.4deg, #201e46 0%, #6690b7 88.73%);">

  <!-- Outer wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="min-height: 100vh;">
    <tr>
      <td align="center" style="padding: 48px 16px;">

        <!-- Card -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 480px; background: linear-gradient(167.4deg, #201e46 0%, #6690b7 88.73%); border: 1px solid rgba(255,255,255,0.13); border-radius: 24px; overflow: hidden;">

          <!-- Top accent bar -->
          <tr>
            <td style="height: 3px; background: linear-gradient(90deg, #fa5151, #ff8c5a, #fa5151); background-size: 200% 100%;"></td>
          </tr>

          <!-- Header / branding -->
          <tr>
            <td align="center" style="padding: 40px 40px 32px 40px;">
              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center">
                    <!-- Logo container -->
                    <div style="width: 60px; height: 60px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                      <img
                        src="https://raw.githubusercontent.com/trouni/predictor-vue/acfcd26d67ee381792f21f91769b2f747719d717/src/assets/logo.png"
                        alt="Octacle"
                        width="36"
                        height="36"
                        style="display: block; width: 36px; height: 36px; object-fit: contain;"
                      />
                    </div>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top: 4px;">
                    <span style="font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: -0.3px;">Octacle</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding: 0 40px;">
              <div style="height: 1px; background: rgba(255,255,255,0.09);"></div>
            </td>
          </tr>

          <!-- Body content -->
          <tr>
            <td style="padding: 36px 40px 32px 40px;">

              <!-- Heading -->
              <h1 style="margin: 0 0 12px 0; font-size: 24px; font-weight: 700; color: #ffffff; letter-spacing: -0.4px; line-height: 1.2;">
                Reset your password
              </h1>

              <!-- Subtext -->
              <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.55);">
                Hello! Someone requested a password reset for your Octacle account. If that was you, tap the button below to choose a new one.
              </p>

              <!-- CTA Button -->
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td align="center">
                    <a
                      href="<%= edit_password_url(@resource, reset_password_token: @token, config: message['client-config'].to_s, redirect_url: message['redirect-url'].to_s) %>"
                      style="display: inline-block; padding: 14px 32px; background: #fa5151; color: #ffffff; font-size: 15px; font-weight: 700; text-decoration: none; border-radius: 12px; letter-spacing: 0.1px; transition: opacity 0.2s;"
                    >
                      Reset my password &rarr;
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding: 0 40px;">
              <div style="height: 1px; background: rgba(255,255,255,0.09);"></div>
            </td>
          </tr>

          <!-- Notice / footer -->
          <tr>
            <td style="padding: 24px 40px 40px 40px;">

              <!-- Lock icon + notice -->
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td valign="top">
                    <p style="margin: 0; font-size: 13px; line-height: 1.6; color: rgba(255,255,255,0.38);">
                      If you didn't request this, you can safely ignore this email. Your password won't change until you click the link above. This link expires in 24 hours.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Bottom brand footer -->
          <tr>
            <td style="padding: 20px 40px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.07);">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td>
                    <p style="margin: 0; font-size: 12px; color: rgba(255,255,255,0.25);">
                      &copy; <%= Time.current.year %> Octacle. All rights reserved.
                    </p>
                  </td>
                  <td align="right">
                    <span style="font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.3); letter-spacing: 0.5px;">OCTACLE</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- /Card -->

      </td>
    </tr>
  </table>

</body>
