<p style="margin:0 0 10px; font-size:11px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#8b87c0;">Account update</p>
<h1 style="margin:0 0 12px; font-size:22px; font-weight:800; color:#1a1833; letter-spacing:-0.02em; line-height:1.2;">Email address changed</h1>

<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#4a4869;">
    Hey <strong style="color:#1a1833; font-weight:600;"><%= @email %></strong> — your Octacle email address is being changed to <strong style="color:#1a1833; font-weight:600;"><%= @resource.unconfirmed_email %></strong>. You'll receive a confirmation email at the new address shortly.
  </p>
<% else %>
  <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#4a4869;">
    Hey <strong style="color:#1a1833; font-weight:600;"><%= @email %></strong> — your Octacle email address has been updated to <strong style="color:#1a1833; font-weight:600;"><%= @resource.email %></strong>.
  </p>
<% end %>

<hr style="border:none; border-top:1px solid #eeecf8; margin:24px 0;" />

<div style="background:#f6f5ff; border-radius:12px; padding:14px 16px; font-size:13px; color:#6b68a0; line-height:1.5; border-left:3px solid #8b87c0;">
  If you didn't make this change, please contact us immediately — your account may have been accessed without your permission.
</div>
